{
    "name": "AtCoder-InBrowser-Playground",
    "version": "0.0.0",
    "private": true,
    "description": "AtCoder In-Browser Playground",
    "type": "module",
    "scripts": {
        "postinstall": "wxt prepare",
        "build:engine:qjs-wamr": "bash engine/quickjs-wamr/scripts/build.sh",
        "build:engine:clang": "bash engine/clang-wasi/scripts/build.sh",
        "build:engines": "pnpm run build:engine:qjs-wamr && pnpm run build:engine:clang",
        "dev:chrome": "wxt",
        "dev:firefox": "wxt -b firefox",
        "test": "pnpm run test:type-check && pnpm run test:fmt && pnpm run test:lint && pnpm run test:unit",
        "test:fmt": "oxfmt",
        "test:fmt:check": "oxfmt --check",
        "test:lint": "oxlint --fix .",
        "test:lint:check": "oxlint .",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:type-check": "tsc --noEmit",
        "build:ext:chrome": "wxt build",
        "build:ext:firefox": "wxt build -b firefox",
        "build:ext": "pnpm run build:ext:chrome && pnpm run build:ext:firefox",
        "zip:chrome": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "zip": "pnpm run test && pnpm run zip:chrome && pnpm run zip:firefox",
        "zip:full": "pnpm run build:engines && pnpm run zip"
    },
    "dependencies": {
        "@bjorn3/browser_wasi_shim": "0.4.2",
        "@jitl/quickjs-ffi-types": "0.32.0",
        "@jridgewell/trace-mapping": "^0.3.31",
        "@preact/signals": "^2.9.3",
        "@ruby/wasm-wasi": "2.10.1",
        "monaco-editor": "0.55.1",
        "object-inspect": "^1.13.4",
        "preact": "^10.29.7",
        "pyodide": "^314.0.2",
        "quickjs-emscripten-core": "^0.32.0",
        "sucrase": "^3.35.1",
        "wasmoon": "1.16.0"
    },
    "devDependencies": {
        "@preact/preset-vite": "^2.10.5",
        "@wxt-dev/auto-icons": "^1.1.1",
        "core-js-builder": "^3.49.0",
        "esbuild": "^0.28.1",
        "oxfmt": "^0.58.0",
        "oxlint": "^1.73.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10",
        "wxt": "^0.20.27"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": ">=11.0.0 <12.0.0",
            "onFail": "download"
        }
    }
}
